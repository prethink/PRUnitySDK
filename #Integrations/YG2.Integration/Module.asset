  id: YG2
  displayName: "\u042F\u043D\u0434\u0435\u043A\u0441 \u0418\u0433\u0440\u044B (YG2)"
  description: "\u041F\u043B\u0430\u0433\u0438\u043D YG2: \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E,
    \u0432\u0440\u0435\u043C\u044F \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438,
    \u043C\u0435\u0442\u0440\u0438\u043A\u0430, \u043E\u0431\u043B\u0430\u0447\u043D\u043E\u0435
    \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435, \u0444\u043B\u0430\u0433\u0438,
    \u044F\u0437\u044B\u043A, \u0438\u043C\u044F \u0438\u0433\u0440\u043E\u043A\u0430;
    \u0432 \u043F\u0440\u0438\u0432\u0430\u0442\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438
    \u2014 \u0440\u0435\u043A\u043B\u0430\u043C\u0430, \u043F\u043E\u043A\u0443\u043F\u043A\u0438,
    \u0440\u0435\u0439\u0442\u0438\u043D\u0433 \u0438 \u043F\u0440\u0438\u0437\u0440\u0430\u043A\u0438."
